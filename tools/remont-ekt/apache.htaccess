# Apache 2.4 / mod_rewrite. Install ONLY at the domain document root.
Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
RewriteEngine On
# Keep ACME webroot validation available for certificate issuance/renewal.
RewriteRule ^\.well-known/acme-challenge/[A-Za-z0-9_-]+$ - [L]
# Confirm that HTTPS is available before enabling these redirects.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^remontekt\.ru$ [NC]
RewriteRule ^ https://remontekt.ru%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ https://remontekt.ru/ [R=301,L,NE]
# Deployment instructions/configuration are not public website content.
<FilesMatch "^(?:HOSTING\.md|SHA256SUMS|nginx\.conf\.example)$">
 Require all denied
</FilesMatch>
<IfModule mod_headers.c>
 Header always set X-Content-Type-Options "nosniff"
 Header always set Referrer-Policy "no-referrer"
 Header always set X-Frame-Options "DENY"
 Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
 # Start in report-only mode; enforce after verifying the actual host.
 Header always set Content-Security-Policy-Report-Only "{{CSP}}"
 <FilesMatch "\.(?:html|xml|txt)$">
  Header set Cache-Control "no-cache"
 </FilesMatch>
 <FilesMatch "\.(?:css|js)$">
  Header set Cache-Control "public, max-age=3600, must-revalidate"
 </FilesMatch>
 <FilesMatch "\.(?:jpg|jpeg|png|webp|svg|woff2)$">
  Header set Cache-Control "public, max-age=604800"
 </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
 AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
# Do not add HSTS/includeSubDomains until all domain HTTPS endpoints are proven.
